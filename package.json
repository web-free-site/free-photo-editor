{
  "name": "free-photo-editor",
  "version": "4.14.3",
  "author": "Vilius L.",
  "description": "Online graphics editing tool lets create, edit images using HTML5 technologies.",
  "keywords": [
    "canvas",
    "drawing",
    "paint",
    "layers",
    "effects"
  ],
  "scripts": {
    "server": "webpack serve --mode development --env development --open",
    "dev": "webpack --mode development",
    "build": "webpack --mode production && node scripts/assemble-dist.mjs && node scripts/prerender-pages.mjs && node scripts/generate-sitemap.mjs && node scripts/inject-more-tools.mjs",
    "preview:cf": "npm run build && npx wrangler dev",
    "test": "npm run build && node scripts/verify-editor.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web-free-site/free-photo-editor"
  },
  "homepage": "https://free-photo-editor.web-free.site",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.5",
    "babel-loader": "^8.2.2",
    "css-loader": "^5.2.6",
    "playwright": "1.49",
    "source-map-loader": "^3.0.0",
    "style-loader": "^2.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.14.5",
    "alertifyjs": "^1.13.1",
    "blueimp-canvas-to-blob": "^3.28.0",
    "exif-js": "^2.3.0",
    "file-saver": "^2.0.5",
    "fuzzysort": "^1.1.4",
    "gif.js.optimized": "^1.0.1",
    "hermite-resize": "git+https://github.com/viliusle/Hermite-resize.git",
    "jquery": "^3.5.1",
    "pica": "^7.0.0",
    "semver-compare": "^1.0.0",
    "uuid": "^8.3.2",
    "webfontloader": "^1.6.28"
  }
}
